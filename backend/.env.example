SECRET_KEY=deal-room-local-secret-change-me
JWT_SECRET_KEY=deal-room-local-jwt-change-me

CORS_ORIGINS=http://localhost:5173
UPLOAD_PATH=uploads
STORAGE_PROVIDER=local
